# Every setting the app reads. Copy to .env for local work; on Railway, set them
# under the service → Variables. docs/production-setup.md lists the values the
# production service needs.
#
# VITE_ settings are baked into the site when it is built: after changing one on
# Railway, redeploy.

# PostgreSQL connection string. On Railway, reference the Postgres service's
# DATABASE_URL. Leave it blank locally and the app uses an embedded Postgres in
# .data/pg instead, with no database server to run.
DATABASE_URL=""

# Public site URL. Used for canonical tags and the sitemap.
# Must keep the VITE_ prefix — that is what exposes it to the browser.
# Set this in Netlify too, otherwise previews carry the wrong canonical.
VITE_SITE_URL="https://www.royalwoodshop.com"

# Lets search engines crawl the site. Off unless exactly "on": until then
# robots.txt disallows everything and the sitemap is empty. Set it to on for the
# production service only, once it serves www.royalwoodshop.com, so a preview or
# staging copy never competes with the live site.
VITE_SEARCH_INDEXING=

# Admin session signing key. Generate one with:  openssl rand -base64 32
# In production the admin refuses to sign anyone in until this is set.
SESSION_SECRET=""

# Where images uploaded through the admin are written. On Railway this must be
# the mount path of the service's persistent volume (the service → Settings →
# Volumes), or uploads vanish on the next deploy. Blank locally: public/uploads.
UPLOAD_DIR=

# ---------------------------------------------------------------- Search Console
# Powers the Search Console panel on the admin dashboard. Leave both blank and
# the panel simply shows setup instructions instead — nothing breaks.
#
# The property exactly as Google names it. Copy it from the Search Console URL
# (the resource_id parameter, URL-decoded). Note http vs https and www vs not —
# they are different properties to Google. For production, the royalwoodshop.com
# property: sc-domain:royalwoodshop.com (a Domain property) or
# https://www.royalwoodshop.com/ (a URL-prefix property).
GSC_SITE_URL=""

# The whole service-account JSON key file, on one line, single-quoted.
# See docs/search-console-setup.md for how to create it.
GSC_SERVICE_ACCOUNT_JSON=''

# Google Analytics 4, read by the admin dashboard through the Data API.
# The NUMERIC PROPERTY id — Analytics shows three numbers side by side and only
# this one works: the account id (6939042) and the measurement id (G-XXXXXXX)
# will both be rejected. Uses the same service-account key above, but the
# account must be granted Viewer on the property separately.
GA4_PROPERTY_ID=

# Google Tag Manager container that sends page views to GA4. Production only:
# leave blank everywhere else so local and preview builds send no traffic.
# Read at build time (VITE_), so redeploy after changing it. GTM-TW6NDWG is the
# container with the GA4 tags; the old site's other one, GTM-KRF8FQJC, is empty.
VITE_GTM_ID=

# ------------------------------------------------------------------ AI Assist
# Powers AI Assist in the blog editor. See docs/ai-assist-setup.md.
#
# Drafting articles, the search listing and image descriptions: Anthropic.
# Without it the AI Assist button stays greyed out.
ANTHROPIC_API_KEY=""
# Rendering header images: OpenAI (the API platform, not ChatGPT Plus).
OPENAI_API_KEY=""

# All optional. Model names change; set these if the defaults are rejected.
# ANTHROPIC_TEXT_MODEL="claude-haiku-4-5-20251001"
# OPENAI_IMAGE_MODEL="gpt-image-1"
# OPENAI_IMAGE_SIZE="1536x1024"

# ------------------------------------------------------------- Contact form
# Every enquiry is saved to the contact_messages table first; these settings
# only control the email notification. Any SMTP provider works (Google
# Workspace, Microsoft 365, Resend, Postmark…). Leave SMTP_HOST blank and
# messages are still saved, just not emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Sender shown in the inbox. Many providers require it to match SMTP_USER.
SMTP_FROM="Royal Wood Shop website <web@royalwoodshop.com>"
# Who receives enquiries. Comma-separate for more than one.
CONTACT_TO="info@royalwoodshop.com"

# --------------------------------------------------------------- Newsletter
# The footer signup adds people to this Mailchimp audience once they confirm by
# email. Leave blank and the form says signup is unavailable.
# API key: Mailchimp → profile → Extras → API keys (it ends in the data centre,
# e.g. -us21). Audience ID: Audience → Settings → Audience name and defaults.
MAILCHIMP_API_KEY=""
MAILCHIMP_AUDIENCE_ID=""

# ---------------------------------------------------------------- Build log
# Optional. The admin's build log reads the git history through the GitHub API
# on Railway. The repository is public, so a token only raises the rate limit;
# it becomes required if the repository is ever made private.
GITHUB_TOKEN=""
