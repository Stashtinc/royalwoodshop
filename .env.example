# Neon Postgres connection string.
# Neon dashboard → your project → Connection string → copy the pooled URL.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/royalwoodshop?sslmode=require"

# Public site URL. Used for canonical tags and the sitemap.
# Must keep the VITE_ prefix — that is what exposes it to the browser.
# Set this in Netlify too, otherwise previews carry the wrong canonical.
VITE_SITE_URL="https://www.royalwoodshop.com"

# Admin session signing key. Generate one with:  openssl rand -base64 32
SESSION_SECRET=""

# ---------------------------------------------------------------- Search Console
# Powers the Search Console panel on the admin dashboard. Leave both blank and
# the panel simply shows setup instructions instead — nothing breaks.
#
# The property exactly as Google names it. Copy it from the Search Console URL
# (the resource_id parameter, URL-decoded). Note http vs https and www vs not —
# they are different properties to Google.
GSC_SITE_URL="http://www.cbeckermann.com/"

# The whole service-account JSON key file, on one line, single-quoted.
# See docs/search-console-setup.md for how to create it.
GSC_SERVICE_ACCOUNT_JSON=''

# ------------------------------------------------------------------ AI Assist
# Powers the AI Assist button in the blog editor. Leave blank and the button is
# disabled — nothing else changes. See docs/ai-assist-setup.md.
# Get a key at https://console.anthropic.com (pay-as-you-go, not a Claude plan).
ANTHROPIC_API_KEY=""

# Optional. Defaults to Claude Haiku.
# ANTHROPIC_MODEL="claude-sonnet-5"
